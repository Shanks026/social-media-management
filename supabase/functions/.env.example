# Copy to supabase/functions/.env for `supabase functions serve` / the local stack.
# Never commit the real .env.

RESEND_API_KEY=
FRONTEND_URL=http://localhost:5173

# Email fail-safe (ADR 0005, supabase/functions/_shared/email.ts):
#   live      deliver as addressed: production only
#   redirect  rewrite every to/cc/bcc to delivered+<name>@resend.dev
#   block     send nothing (also what happens when this is unset)
EMAIL_MODE=redirect
